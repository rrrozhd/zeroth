# Build the hosted wheel from the Git checkout so Railway does not depend on a
# gitignored local dist/ directory.
FROM python:3.12.13-slim-bookworm AS builder

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /dist .

FROM python:3.12.13-slim-bookworm

LABEL org.opencontainers.image.version=0.25.7.3

RUN useradd --create-home --uid 10001 zeroth
COPY requirements-image.txt /tmp/requirements-image.txt
COPY --from=builder /dist/zeroth_core-*.whl /opt/zeroth/wheel/
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r /tmp/requirements-image.txt \
    && pip install --no-cache-dir --no-deps /opt/zeroth/wheel/zeroth_core-*.whl \
    && rm /tmp/requirements-image.txt

ENV PORT=8000

USER zeroth
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready',timeout=4)"]

CMD ["uvicorn", "zeroth.econ.plane.main:app", "--host", "0.0.0.0", "--port", "8000"]
