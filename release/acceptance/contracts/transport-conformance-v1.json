{
  "schema_version": 1,
  "supported_agent_server_versions": [
    "0.11.1"
  ],
  "scenarios": {
    "readiness": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "status": "ok",
            "checks": {
              "database": {
                "status": "ok"
              }
            }
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "GET",
          "path": "/__acceptance/identity",
          "expected_status": 200,
          "expected_json": {
            "deployment_ref": "{deployment_ref}"
          }
        }
      ]
    },
    "authentication": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/v1/deployments",
          "expected_status": 401
        }
      ]
    },
    "rbac": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "POST",
          "path": "/api/studio/v1/workflows",
          "payload": {
            "name": "{namespace}-forbidden"
          },
          "expected_status": 403
        }
      ]
    },
    "migrations": {
      "steps": [
        {
          "protocol": "http",
          "role": "admin",
          "method": "GET",
          "path": "/__acceptance/migrations",
          "expected_status": 200,
          "expected_json": {
            "current": true
          }
        }
      ]
    },
    "workflow_lifecycle": {
      "steps": [
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/api/studio/v1/workflows",
          "payload": {
            "name": "{namespace}-workflow"
          },
          "expected_status": 201,
          "expected_json": {
            "name": "{namespace}-workflow",
            "status": "draft"
          },
          "owned_capture": {
            "workflow_id": "id"
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/api/studio/v1/workflows/{workflow_id}",
          "expected_status": 200,
          "expected_json": {
            "id": "{workflow_id}",
            "name": "{namespace}-workflow"
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/api/studio/v1/workflows/{workflow_id}/publish",
          "payload": {
            "namespace": "{namespace}"
          },
          "expected_status": 200,
          "expected_json": {
            "status": "published"
          }
        }
      ]
    },
    "deployment": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/health",
          "expected_status": 200,
          "expected_json": {
            "deployment_ref": "{deployment_ref}"
          }
        }
      ]
    },
    "runs": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/runs",
          "payload": {
            "namespace": "{namespace}"
          },
          "expected_status": 202,
          "expected_json": {
            "tenant_id": "{tenant_id}",
            "namespace": "{namespace}"
          },
          "require_correlation": true,
          "capture": {
            "run_id": "run_id"
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/__acceptance/runs/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "status": "succeeded"
          },
          "poll": true
        }
      ]
    },
    "streaming": {
      "steps": [
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/__acceptance/runs/{run_id}/stream",
          "payload": {
            "run_id": "{run_id}"
          },
          "max_events": 3,
          "ordered_events": [
            "run.started",
            "node.completed",
            "run.completed"
          ]
        }
      ]
    },
    "approvals": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/__acceptance/timeline/before",
          "expected_status": 200,
          "count_path": "entries",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 0,
          "capture": {
            "approval_id": "approval_id"
          }
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "POST",
          "path": "/__acceptance/approvals/{approval_id}/resolve",
          "payload": {
            "decision": "approve"
          },
          "expected_status": 200
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/__acceptance/timeline/after",
          "expected_status": 200,
          "count_path": "entries",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        }
      ]
    },
    "audit": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/__acceptance/audit/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "tenant_id": "{tenant_id}",
            "causally_ordered": true
          }
        }
      ]
    },
    "artifacts": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/__acceptance/artifacts/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "system_produced": true
          },
          "capture": {
            "artifact_id": "artifact_id"
          }
        }
      ]
    },
    "retention": {
      "steps": [
        {
          "protocol": "http",
          "role": "admin",
          "method": "GET",
          "path": "/v1/retention/policy",
          "expected_status": 200,
          "expected_json": {
            "enabled": true
          }
        }
      ]
    },
    "gateway_http": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/gateway/http",
          "payload": {
            "namespace": "{namespace}",
            "case": "allow"
          },
          "expected_status": 200,
          "expected_json": {
            "decision": "allow"
          },
          "require_correlation": true
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/gateway/http",
          "payload": {
            "namespace": "{namespace}",
            "case": "deny"
          },
          "expected_status": 403,
          "expected_json": {
            "decision": "deny"
          },
          "require_correlation": true
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/gateway/http",
          "payload": {
            "namespace": "{namespace}",
            "case": "approval"
          },
          "expected_status": 202,
          "expected_json": {
            "decision": "approval_required"
          },
          "require_correlation": true
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "POST",
          "path": "/__acceptance/gateway/http",
          "payload": {
            "namespace": "{namespace}",
            "case": "resume"
          },
          "expected_status": 200,
          "expected_json": {
            "decision": "resumed"
          },
          "require_correlation": true
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/gateway/http",
          "payload": {
            "namespace": "{namespace}",
            "case": "upstream_failure"
          },
          "expected_status": 502,
          "expected_json": {
            "decision": "upstream_error"
          },
          "require_correlation": true
        }
      ]
    },
    "gateway_websocket": {
      "steps": [
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/__acceptance/gateway/ws/allow",
          "payload": {
            "namespace": "{namespace}"
          },
          "max_events": 3,
          "ordered_events": [
            "gateway.admitted",
            "gateway.forwarded",
            "gateway.completed"
          ]
        },
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/__acceptance/gateway/ws/deny",
          "payload": {
            "namespace": "{namespace}"
          },
          "max_events": 2,
          "ordered_events": [
            "gateway.admitted",
            "gateway.denied"
          ]
        },
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/__acceptance/gateway/ws/approval",
          "payload": {
            "namespace": "{namespace}"
          },
          "max_events": 2,
          "ordered_events": [
            "gateway.admitted",
            "gateway.approval_required"
          ]
        },
        {
          "protocol": "websocket",
          "role": "reviewer",
          "path": "/__acceptance/gateway/ws/resume",
          "payload": {
            "namespace": "{namespace}"
          },
          "max_events": 3,
          "ordered_events": [
            "gateway.resumed",
            "gateway.forwarded",
            "gateway.completed"
          ]
        },
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/__acceptance/gateway/ws/upstream-failure",
          "payload": {
            "namespace": "{namespace}"
          },
          "max_events": 3,
          "ordered_events": [
            "gateway.admitted",
            "gateway.forwarded",
            "gateway.upstream_error"
          ]
        }
      ]
    },
    "compatibility": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/__acceptance/compatibility",
          "expected_status": 200,
          "expected_json": {
            "status": "supported",
            "detected_agent_server": "0.11.1"
          }
        }
      ]
    },
    "executable_unit_failures": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/executable-units/resolve",
          "payload": {
            "artifact": "{namespace}-missing"
          },
          "expected_status": 422,
          "expected_json": {
            "error_code": "unresolved_project_artifact"
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/__acceptance/executable-units/run",
          "payload": {
            "artifact": "{namespace}-unstaged"
          },
          "expected_status": 422,
          "expected_json": {
            "error_code": "unstaged_project_artifact"
          }
        }
      ]
    },
    "restart_recovery": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/__acceptance/durability/{run_id}",
          "expected_status": 200,
          "count_path": "audits",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        },
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "restart"
        },
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "status": "ok"
          },
          "poll": true
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/__acceptance/durability/{run_id}",
          "expected_status": 200,
          "count_path": "audits",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        }
      ]
    },
    "shutdown": {
      "steps": [
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "shutdown"
        },
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 503,
          "expected_json": {
            "status": "draining"
          }
        }
      ]
    }
  },
  "cleanup": [
    {
      "protocol": "http",
      "role": "admin",
      "method": "DELETE",
      "path": "/api/studio/v1/workflows/{workflow_id}",
      "expected_status": 204,
      "resource_id": "{workflow_id}"
    },
    {
      "protocol": "http",
      "role": "admin",
      "method": "DELETE",
      "path": "/__acceptance/fixtures/{namespace}",
      "expected_status": 204,
      "resource_id": "{namespace}"
    }
  ]
}
