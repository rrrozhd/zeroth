{
  "schema_version": 1,
  "supported_agent_server_versions": [
    "0.11.1"
  ],
  "scenarios": {
    "readiness": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "status": "ok",
            "checks": {
              "database": {
                "status": "ok"
              }
            }
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/health",
          "expected_status": 200,
          "expected_json": {
            "deployment_ref": "{deployment_ref}"
          }
        }
      ]
    },
    "authentication": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/v1/runs",
          "expected_status": 401
        }
      ]
    },
    "rbac": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "POST",
          "path": "/api/studio/v1/workflows",
          "payload": {
            "name": "{namespace}-forbidden"
          },
          "expected_status": 403
        }
      ]
    },
    "migrations": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "schema_revision": {
              "applied": "026",
              "head": "026",
              "state": "current"
            }
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "GET",
          "path": "/regulus/health",
          "expected_status": 200,
          "expected_json": {
            "schema_revision": {
              "applied": "20260812_04",
              "head": "20260812_04",
              "state": "current"
            }
          }
        }
      ]
    },
    "workflow_lifecycle": {
      "steps": [
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/api/studio/v1/workflows",
          "payload": {
            "name": "{namespace}-workflow"
          },
          "expected_status": 201,
          "expected_json": {
            "name": "{namespace}-workflow",
            "status": "draft"
          },
          "owned_capture": {
            "workflow_id": "id"
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/api/studio/v1/workflows/{workflow_id}",
          "expected_status": 200,
          "expected_json": {
            "id": "{workflow_id}",
            "name": "{namespace}-workflow"
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "PUT",
          "path": "/api/studio/v1/workflows/{workflow_id}",
          "payload": {
            "nodes": [
              {
                "id": "start",
                "type": "entrypoint",
                "position": {
                  "x": -200,
                  "y": 0
                },
                "data": {
                  "label": "Start",
                  "input_contract_ref": "contract://input",
                  "output_contract_ref": "contract://input",
                  "config": {}
                }
              },
              {
                "id": "step",
                "type": "agent",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "data": {
                  "label": "Step",
                  "input_contract_ref": "contract://input",
                  "output_contract_ref": "contract://output",
                  "config": {
                    "instruction": "Echo the input.",
                    "model_provider": "openai/gpt-4o-mini"
                  }
                }
              }
            ],
            "edges": [
              {
                "id": "edge-1",
                "source": "start",
                "target": "step"
              }
            ]
          },
          "expected_status": 200,
          "expected_json": {
            "entry_step": "start"
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/api/studio/v1/workflows/{workflow_id}/publish",
          "expected_status": 200,
          "expected_json": {
            "status": "published"
          }
        }
      ]
    },
    "deployment": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/health",
          "expected_status": 200,
          "expected_json": {
            "deployment_ref": "{deployment_ref}"
          }
        }
      ]
    },
    "runs": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/v1/runs",
          "payload": {
            "input_payload": {
              "value": 3
            }
          },
          "expected_status": 202,
          "expected_json": {
            "deployment_ref": "{deployment_ref}",
            "tenant_id": "{tenant_id}"
          },
          "capture": {
            "run_id": "run_id"
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/v1/runs/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "status": "paused_for_approval"
          },
          "poll": true,
          "capture": {
            "approval_id": "approval_paused_state.approval_id"
          }
        }
      ]
    },
    "approvals": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/timeline",
          "expected_status": 200,
          "count_path": "entries",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 0
        },
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "restart"
        },
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "status": "ok"
          },
          "poll": true
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/v1/runs/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "status": "paused_for_approval"
          },
          "poll": true
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/timeline",
          "expected_status": 200,
          "count_path": "entries",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 0
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "POST",
          "path": "/v1/deployments/{deployment_ref}/approvals/{approval_id}/resolve",
          "payload": {
            "decision": "approve"
          },
          "expected_status": 200
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/v1/runs/{run_id}",
          "expected_status": 200,
          "expected_json": {
            "status": "succeeded"
          },
          "poll": true,
          "capture": {
            "artifact_key": "terminal_output.artifact.key"
          }
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/timeline",
          "expected_status": 200,
          "count_path": "entries",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        }
      ]
    },
    "audit": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/timeline",
          "expected_status": 200,
          "expected_json": {
            "run_id": "{run_id}",
            "deployment_ref": "{deployment_ref}"
          },
          "count_path": "entries",
          "count_where": {
            "status": "approval_api"
          },
          "expected_count": 1
        }
      ]
    },
    "artifacts": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/evidence",
          "expected_status": 200,
          "count_path": "audits",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/v1/artifacts/{artifact_key}",
          "expected_status": 200
        }
      ]
    },
    "retention": {
      "steps": [
        {
          "protocol": "http",
          "role": "admin",
          "method": "GET",
          "path": "/v1/retention/policy",
          "expected_status": 200,
          "expected_json": {
            "enabled": true
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/v1/retention/legal-holds",
          "payload": {
            "run_id": "{run_id}",
            "reason": "{namespace} acceptance hold"
          },
          "expected_status": 201,
          "expected_json": {
            "active": true,
            "run_id": "{run_id}",
            "tenant_id": "{tenant_id}"
          },
          "owned_capture": {
            "hold_id": "hold_id"
          }
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "POST",
          "path": "/v1/retention/erasure-requests",
          "payload": {
            "run_id": "{run_id}"
          },
          "expected_status": 409
        },
        {
          "protocol": "http",
          "role": "admin",
          "method": "DELETE",
          "path": "/v1/retention/legal-holds/{hold_id}",
          "expected_status": 200,
          "resource_id": "{hold_id}"
        }
      ]
    },
    "restart_recovery": {
      "steps": [
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/evidence",
          "expected_status": 200,
          "expected_json": {
            "run": {
              "run_id": "{run_id}",
              "status": "succeeded"
            }
          },
          "count_path": "audits",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        },
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "restart"
        },
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "status": "ok"
          },
          "poll": true
        },
        {
          "protocol": "http",
          "role": "reviewer",
          "method": "GET",
          "path": "/v1/runs/{run_id}/evidence",
          "expected_status": 200,
          "expected_json": {
            "run": {
              "run_id": "{run_id}",
              "status": "succeeded"
            }
          },
          "count_path": "audits",
          "count_where": {
            "node_id": "finish-step",
            "status": "completed"
          },
          "expected_count": 1
        }
      ]
    },
    "gateway_http": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/runs/wait",
          "payload": {
            "assistant_id": "shell",
            "input": {
              "value": 1
            }
          },
          "expected_status": 200,
          "expected_json": {
            "echoed": "1"
          },
          "require_correlation": true
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/runs/wait",
          "payload": {
            "assistant_id": "{namespace}-deny",
            "input": {
              "value": 1
            }
          },
          "expected_status": 403,
          "expected_json": {
            "code": "zeroth.policy_denied"
          },
          "require_correlation": true
        },
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "stop_upstream"
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/runs/wait",
          "payload": {
            "assistant_id": "shell",
            "input": {
              "value": 1
            }
          },
          "expected_status": 502,
          "expected_json": {
            "code": "zeroth.upstream_unavailable"
          },
          "require_correlation": true
        },
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "start_upstream"
        }
      ]
    },
    "gateway_websocket": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/threads",
          "payload": {},
          "expected_status": 200,
          "require_correlation": true,
          "capture": {
            "thread": "thread_id"
          }
        },
        {
          "protocol": "websocket",
          "role": "operator",
          "path": "/threads/{thread}/stream/events",
          "frames": [
            {
              "id": 1,
              "method": "subscription.subscribe",
              "params": {
                "channels": [
                  "lifecycle",
                  "values"
                ]
              }
            },
            {
              "id": 2,
              "method": "run.start",
              "params": {
                "assistant_id": "shell",
                "input": {
                  "value": 1
                }
              }
            }
          ],
          "max_events": 6,
          "event_selector": {
            "type": "event"
          },
          "event_name_key": "method",
          "event_sequence_key": "seq",
          "ordered_events": [
            "lifecycle",
            "values",
            "values",
            "lifecycle"
          ]
        }
      ]
    },
    "compatibility": {
      "steps": [
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expected_status": 200,
          "expected_json": {
            "checks": {
              "agent_server": {
                "status": "supported"
              }
            }
          }
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "GET",
          "path": "/health",
          "expected_status": 200,
          "expected_json": {
            "langgraph_gateway": {
              "compatibility": {
                "status": "supported",
                "detected_agent_server": "0.11.1"
              }
            }
          }
        }
      ]
    },
    "executable_unit_failures": {
      "steps": [
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/v1/runs",
          "payload": {
            "input_payload": {
              "unresolvable": "{namespace}"
            }
          },
          "expected_status": 422
        },
        {
          "protocol": "http",
          "role": "operator",
          "method": "POST",
          "path": "/v1/runs",
          "payload": {
            "input_payload": {}
          },
          "expected_status": 422
        }
      ]
    },
    "shutdown": {
      "steps": [
        {
          "protocol": "lifecycle",
          "role": "admin",
          "operation": "shutdown"
        },
        {
          "protocol": "http",
          "role": "anonymous",
          "method": "GET",
          "path": "/health/ready",
          "expect_unreachable": true
        }
      ]
    }
  },
  "cleanup": [
    {
      "protocol": "http",
      "role": "admin",
      "method": "DELETE",
      "path": "/api/studio/v1/workflows/{workflow_id}",
      "expected_status": 204,
      "resource_id": "{workflow_id}"
    }
  ]
}
