FROM python:3.12.13-slim-bookworm

LABEL org.opencontainers.image.version=0.23.9.6

RUN useradd --create-home --uid 10001 vendor-dd
COPY .zeroth-certifier/requirements-image.txt /tmp/requirements-image.txt
COPY .zeroth-certifier/zeroth_core-0.23.9.6-py3-none-any.whl /opt/zeroth/
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r /tmp/requirements-image.txt \
    && pip install --no-cache-dir --no-deps \
        /opt/zeroth/zeroth_core-0.23.9.6-py3-none-any.whl \
    && rm /tmp/requirements-image.txt

WORKDIR /opt/vendor/app
COPY apps/vendor_dd /opt/vendor/app/apps/vendor_dd
ENV PYTHONPATH=/opt/vendor/app \
    HOST=0.0.0.0 \
    PORT=8000 \
    ZEROTH_DATABASE__BACKEND=sqlite \
    ZEROTH_DATABASE__SQLITE_PATH=/data/vendor_dd.sqlite \
    ZEROTH_ARTIFACT_STORE__FILESYSTEM_BASE_DIR=/data/artifacts \
    ZEROTH_REDIS__MODE=disabled \
    ZEROTH_REGULUS__ENABLED=true \
    ZEROTH_WEBHOOK__ENABLED=false \
    ZEROTH_APPROVAL_SLA__ENABLED=false \
    ECP_DATABASE_URL=sqlite:////data/vendor_dd_econ.sqlite \
    ECP_CONNECTOR_SPOOL_ROOT=/data/connector-spool
RUN mkdir -p /data && chown vendor-dd:vendor-dd /data

USER vendor-dd
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=4s --start-period=30s --retries=12 \
    CMD ["python", "-m", "apps.vendor_dd.certification_healthcheck"]
CMD ["python", "-m", "apps.vendor_dd.certification_entrypoint"]
