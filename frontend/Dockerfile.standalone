FROM node:22-alpine AS build

WORKDIR /workspace/frontend
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG ZEROTH_CONSOLE_API_ORIGIN
RUN npx next build \
    && node scripts/render-standalone-nginx.mjs \
      "$ZEROTH_CONSOLE_API_ORIGIN" /tmp/default.conf

FROM nginx:1.29-alpine

COPY --from=build /workspace/frontend/out/ /usr/share/nginx/html/console/
COPY --from=build /tmp/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
