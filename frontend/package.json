{
  "name": "frontend",
  "version": "0.23.10.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:version && next build",
    "start": "next start",
    "gen:api": "uv run --project .. python ../scripts/dump_openapi.py --out openapi.json && openapi-typescript openapi.json -o app/lib/api-types.ts",
    "gen:regulus-api": "uv run --project .. python ../scripts/dump_regulus_openapi.py --out openapi.regulus.json && openapi-typescript openapi.regulus.json -o app/lib/api-types.regulus.ts",
    "gen:all-api": "npm run gen:api && npm run gen:regulus-api",
    "check:api": "uv run --project .. python ../scripts/check_frontend_api.py --frontend .",
    "gen:version": "uv run --project .. python ../scripts/generate_frontend_version.py --pyproject ../pyproject.toml --out app/lib/version.ts",
    "check:version": "uv run --project .. python ../scripts/generate_frontend_version.py --pyproject ../pyproject.toml --out app/lib/version.ts --check",
    "test": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "2.1.2",
    "js-yaml": "4.3.0",
    "postcss": "8.5.10",
    "sharp": "0.35.0"
  }
}
